[Hotkey]
# 切换输入法
TriggerKeys=
# 按住切换键的修饰键时进行轮换切换
# EnumerateWithTriggerKeys=True
# 激活输入法
ActivateKeys=
# 忽略重复的激活/取消激活键
# ConsumeRedundantActivateKeys=False
# 向前切换输入法
# EnumerateForwardKeys=
# 向后切换输入法
# EnumerateBackwardKeys=
# 轮换输入法时跳过第一个输入法
# EnumerateSkipFirst=False
# 切换是否使用嵌入预编辑
TogglePreedit=
# 触发修饰键快捷键的时限 (毫秒)
# ModifierOnlyKeyTimeout=250

[Hotkey/DeactivateKeys]
0=Control+Shift+Shift_L

[Hotkey/AltTriggerKeys]
0=Shift+Shift_L

# [Hotkey/EnumerateGroupForwardKeys]
# 0=Super+space

[Hotkey/EnumerateGroupBackwardKeys]
0=

# [Hotkey/PrevPage]
# 0=Up

# [Hotkey/NextPage]
# 0=Down

# [Hotkey/PrevCandidate]
# 0=Shift+Tab

# [Hotkey/NextCandidate]
# 0=Tab

[Behavior]
# 默认激活输入法
ActiveByDefault=True
# 重新聚焦时重置状态
# resetStateWhenFocusIn=No
# 共享输入状态
# ShareInputState=No
# 在程序中显示预编辑文本（官方译名；默认 True）
#   True  = 把组字串交给程序自己画。支持 client preedit 的程序（Firefox、Steam
#           等）会在输入框里就地显示拼音，fcitx5 自己不再多画一行 —— 单行模式。
#   False = fcitx5 自己画组字串，表现为候选框上方另外多出的一行 —— 两行模式。
# 注意：fcitx5 5.1.23 没有 PreeditType / 单行多行开关（已核对
# libFcitx5Core.so 的选项表，classicui.conf 只含配色·字体·DPI），
# 「两行」只有这一个成因，所以保持默认 True 即为全局单行。
# 代价：SDL2 程序（星露谷）不像 Firefox 那样渲染 client preedit，
# 因此这类程序里不会显示拼音正文，只留候选框；要让它显示拼音就必须
# 改成 False，那会同时把两行模式带回来。
# PreeditEnabledByDefault=True
# 切换输入法时显示输入法信息
# ShowInputMethodInformation=True
# 在焦点更改时显示输入法信息
# showInputMethodInformationWhenFocusIn=False
# 显示紧凑的输入法信息
# CompactInputMethodInformation=True
# 显示第一个输入法的信息
# ShowFirstInputMethodInformation=True
# 缺省每页候选词
DefaultPageSize=9
# 覆盖 XKB 选项
# OverrideXkbOption=False
# 自定义 XKB 选项
# CustomXkbOption=
# Force Enabled Addons
# EnabledAddons=
# Force Disabled Addons
# DisabledAddons=
# Preload input method to be used by default
# PreloadInputMethod=True
# 允许在密码框中使用输入法
# AllowInputMethodForPassword=False
# 输入密码时显示预编辑文本
ShowPreeditForPassword=True
# 保存用户数据的时间间隔（以分钟为单位）
# AutoSavePeriod=30

